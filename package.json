{
  "name": "linkedin-scraper",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "start": "bun run apps/cli/src/index.ts",
    "cli": "bun run apps/cli/src/index.ts",
    "dev:api": "bun run --filter @linkedin-scraper/api dev",
    "dev:web": "bun run --filter @linkedin-scraper/web dev",
    "test": "bun run --filter @linkedin-scraper/core test",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && bun run --filter '@linkedin-scraper/*' typecheck",
    "build": "bun run --filter '@linkedin-scraper/*' build"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.82.0",
    "@types/bun": "latest",
    "oxlint": "1.82.0",
    "typescript": "^5.9.3"
  }
}
